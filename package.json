{
  "name": "@enhanced-dom/build",
  "version": "0.3.1",
  "description": "Basic bundler-agnostic scripts for build & distribution",
  "keywords": [],
  "repository": "https://github.com/enhanced-dom/build.git",
  "license": "MIT",
  "type": "module",
  "author": "CD9B4A105290E17E0948E021DF4105107C88693C59C0B891CCC08366C51AEA990902A6A156AC87D88A2FC41422A5E1C3C4071F251F19441C4516000EC25F87DF",
  "main": "index.js",
  "scripts": {
    "prebuild": "rimraf dist/*",
    "build": "tsc -p ./tsconfig.json",
    "postbuild": "copyfiles LICENSE.md README.md package.json dist && cp tsconfig.json dist/tsconfig.template.json",
    "package": "cd dist && npm pack"
  },
  "bin": {
    "@enhanced-dom-copy-packagejson": "./copyPackageJson.js",
    "@enhanced-dom-bootstrap-tsconfig": "./bootstrapTsconfig.js"
  },
  "dependencies": {
    "copyfiles": "^2.4.1",
    "rimraf": "^6.1.3",
    "tsc-esm-fix": "^3.1.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/yargs": "^17.0.35"
  },
  "engines": {
    "node": ">=22.23.2",
    "npm": ">=12"
  }
}
